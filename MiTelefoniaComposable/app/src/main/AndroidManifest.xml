<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="net.ivanvega.mitelefoniacompose">

    <!-- Features -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Permisos (declaración en manifest) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiTelefoniaCompose"
        tools:targetApi="31">

        <!-- Activity principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MiTelefoniaCompose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiver para SMS u otros eventos (ajusta nombre de clase) -->
        <receiver
            android:name=".MiReceiverTelefonia"
            android:exported="true">
            <intent-filter>
                <!-- Recibir SMS entrantes -->
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
                <!-- Recibir BOOT_COMPLETED si quieres reiniciar el servicio al arrancar -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Declaración del servicio que escucha llamadas (ForegroundService) -->
        <service
            android:name=".CallListenService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
